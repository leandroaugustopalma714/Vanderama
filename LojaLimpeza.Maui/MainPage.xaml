<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LojaLimpeza.Maui.MainPage"
             Title="Meus pedidos"
             BackgroundColor="#F4F7F5">
    <RefreshView x:Name="PageRefresh" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="20,18" Spacing="16">
                <VerticalStackLayout Spacing="3">
                    <Label Text="LOJA LIMPEZA" FontSize="12" CharacterSpacing="2" TextColor="#1D705C" FontAttributes="Bold" />
                    <Label Text="Meus pedidos" FontSize="27" FontAttributes="Bold" TextColor="#18312D" />
                    <Label x:Name="LblStatusApi" Text="Os pedidos e o catálogo ficam salvos neste aparelho." FontSize="12" TextColor="#71817C" />
                </VerticalStackLayout>

                <Border Padding="15" Stroke="#E0E8E3" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Cadastro do cliente" FontSize="11" TextColor="#71817C" />
                            <Label x:Name="LblCliente" Text="Cadastro necessário" FontSize="16" FontAttributes="Bold" TextColor="#18312D" />
                            <Label x:Name="LblDocumento" FontSize="11" TextColor="#71817C" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Atualizar catálogo" Clicked="OnSincronizarClicked" BackgroundColor="#E7F2ED" TextColor="#1D705C" CornerRadius="9" FontSize="12" />
                    </Grid>
                </Border>

                <Button Text="＋  Fazer pedido" Clicked="OnNovoPedidoClicked" BackgroundColor="#173F36" TextColor="White" CornerRadius="10" HeightRequest="52" FontAttributes="Bold" />

                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Pedidos deste aparelho" FontSize="18" FontAttributes="Bold" TextColor="#18312D" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Sincronizar" Clicked="OnSincronizarClicked" FontSize="12" BackgroundColor="White" TextColor="#1D705C" CornerRadius="8" />
                    </Grid>
                    <CollectionView x:Name="ListaPedidos" HeightRequest="480" SelectionMode="None">
                        <CollectionView.EmptyView><Label Text="Você ainda não fez nenhum pedido." Padding="14" TextColor="#71817C" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="13" Stroke="#E0E8E3" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" TextColor="#18312D" />
                                            <Label Text="{Binding Status}" FontSize="11" TextColor="#71817C" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Valor, StringFormat='R$ {0:F2}'}" FontAttributes="Bold" TextColor="#1D705C" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
